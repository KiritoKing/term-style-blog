# Local development needs no .env file and no credentials.
# The default content source is the demo collection in src/content/blog.
# Export these variables in your shell for validation and build:content:
# the Node/tsx prebuild validators do not load .env automatically.

# Absolute path to a directory containing ONLY approved Markdown posts.
# CONTENT_DIR=/absolute/path/to/published

# Optional exact article count guard; use your own count.
# EXPECTED_CONTENT_COUNT=3

# Preview emits noindex; production permits indexing.
# PUBLIC_DEPLOYMENT_ENV=preview

# Reject local/unresolved image references in publication builds.
# STRICT_CONTENT_ASSETS=1

# No Notion credentials are used. Cloudflare/GitHub secrets belong only
# in GitHub Actions secrets, never in this file or in the content tree.
