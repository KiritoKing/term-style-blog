# Notion Integration
# Required for production build with Notion as content source
NOTION_TOKEN=your_notion_integration_token
NOTION_DATABASE_ID=your_notion_database_id

# Local Validation Mode
# When these credentials are missing or invalid, the blog uses
# Markdown fixtures from src/fixtures/blog/ for local development
# and CI validation without requiring real Notion credentials.

# Example: Valid credentials (for production)
# NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxx
# NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Example: No credentials (uses fixtures automatically)
# NOTION_TOKEN=
# NOTION_DATABASE_ID=