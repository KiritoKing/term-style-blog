{
  "name": "term-style-blog",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "prebuild": "tsx scripts/validate-content.ts && tsx scripts/generate-redirects.ts",
    "build": "astro build && pagefind --site dist",
    "build:content": "tsx scripts/validate-content.ts --require-external && tsx scripts/generate-redirects.ts && astro build && pagefind --site dist",
    "build:local": "astro build",
    "dev": "astro dev",
    "preview": "astro preview",
    "preview:e2e": "tsx scripts/serve-dist.ts",
    "precheck": "tsx scripts/validate-content.ts",
    "check": "astro check",
    "validate:local": "astro check",
    "validate:content": "tsx scripts/validate-content.ts --require-external",
    "test:fixtures": "vitest run src/test/fixtures.test.ts",
    "test": "vitest run",
    "test:deployment": "node --test tests/validate-publication-snapshot.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/react": "^4.2.1",
    "@shikijs/rehype": "^3.23.0",
    "astro": "^5.17.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.546.0",
    "mermaid": "^11.17.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@iconify-json/lucide": "^1.2.94",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^26.5.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.3",
    "astro-icon": "^1.1.5",
    "pagefind": "^1.4.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.1.4"
  }
}
