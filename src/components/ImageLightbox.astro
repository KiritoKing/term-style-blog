<dialog
  id="article-image-viewer"
  class="image-lightbox pixel-panel font-console"
  aria-label="图片查看器"
  aria-describedby="image-viewer-help"
  data-image-lightbox
  data-pagefind-ignore
>
  <header class="image-lightbox-header">
    <span class="font-pixel text-xs">IMAGE VIEWER</span>
    <form method="dialog">
      <button class="pixel-btn" aria-label="关闭图片查看器" autofocus>关闭 [ESC]</button>
    </form>
  </header>
  <div class="image-lightbox-stage" data-panzoom-stage tabindex="0" role="group" aria-label="图片缩放区域">
    <div class="image-lightbox-content" data-panzoom-content></div>
  </div>
  <fieldset class="image-lightbox-controls" aria-label="图片缩放控制" disabled data-panzoom-controls>
    <button type="button" class="pixel-btn" aria-label="缩小图片" data-zoom-out>−</button>
    <output aria-label="缩放比例" data-zoom-level>100%</output>
    <button type="button" class="pixel-btn" aria-label="放大图片" data-zoom-in>+</button>
    <button type="button" class="pixel-btn" aria-label="重置适配视图" data-zoom-reset>适配 [0]</button>
  </fieldset>
  <figure class="image-lightbox-description">
    <figcaption data-image-caption></figcaption>
    <p id="image-viewer-help">滚轮 / 双指缩放 · 拖拽移动 · + / − 缩放 · 方向键移动</p>
  </figure>
</dialog>

<script>
  import '@/scripts/image-lightbox';
</script>
