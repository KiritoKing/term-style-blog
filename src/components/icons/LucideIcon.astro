---
import { Icon } from 'astro-icon/components';
import type { LucideIconName } from '@/components/icons/lucide';

interface Props {
  name: LucideIconName;
  size?: number;
  class?: string;
  strokeWidth?: number;
  ariaLabel?: string;
}

const { name, size = 24, strokeWidth = 2, ariaLabel, class: className } = Astro.props;
const iconName = `lucide:${name}`;
---

<Icon
  name={iconName}
  size={size}
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden={ariaLabel ? undefined : 'true'}
  aria-label={ariaLabel}
  role={ariaLabel ? 'img' : undefined}
/>
