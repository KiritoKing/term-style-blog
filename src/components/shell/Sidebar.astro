---
import LucideIcon from '@/components/icons/LucideIcon.astro';
import { networkLinks } from '@/data/network';

interface Props {
  navActive: string;
}

const { navActive } = Astro.props;
---

<div class="w-full md:w-64 flex flex-col gap-4 shrink-0">
  <div class="pixel-panel p-4 flex flex-col items-center text-center">
    <pre class="text-[10px] leading-none mb-4 text-blue-600 dark:text-green-500 font-bold">
{`
 _____ 
/     \\
| () () |
\\  ^  / 
 |||||  
 |||||  
`}
    </pre>
    <h1 class="font-pixel text-xl text-gray-900 dark:text-white mb-1 text-glow-white">ChlorineC</h1>
    <p class="text-sm text-blue-600 dark:text-green-600 mb-4">Coding With Passion</p>

    <div class="w-full h-px bg-gray-300 dark:bg-[#333] my-2"></div>

    <div class="flex flex-col w-full text-left gap-1 mt-2">
      <a
        href="/"
        class={`pixel-btn px-3 py-2 flex items-center gap-3 text-base ${
          navActive === 'home'
            ? 'bg-blue-100 dark:bg-green-900/40 text-blue-600 dark:text-green-400 border-l-2 border-blue-500 dark:border-green-500'
            : 'text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white'
        }`}
      >
        <LucideIcon name="terminal" size={18} /> ~/home
      </a>
      <a
        href="/posts"
        class={`pixel-btn px-3 py-2 flex items-center gap-3 text-base ${
          navActive === 'posts'
            ? 'bg-blue-100 dark:bg-green-900/40 text-blue-600 dark:text-green-400 border-l-2 border-blue-500 dark:border-green-500'
            : 'text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white'
        }`}
      >
        <LucideIcon name="folder" size={18} /> ~/posts
      </a>
      <a
        href="/categories"
        class={`pixel-btn px-3 py-2 flex items-center gap-3 text-base ${
          navActive === 'categories'
            ? 'bg-blue-100 dark:bg-green-900/40 text-blue-600 dark:text-green-400 border-l-2 border-blue-500 dark:border-green-500'
            : 'text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white'
        }`}
      >
        <LucideIcon name="layers" size={18} /> ~/categories
      </a>
      <a
        href="/tags"
        class={`pixel-btn px-3 py-2 flex items-center gap-3 text-base ${
          navActive === 'tags'
            ? 'bg-blue-100 dark:bg-green-900/40 text-blue-600 dark:text-green-400 border-l-2 border-blue-500 dark:border-green-500'
            : 'text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white'
        }`}
      >
        <LucideIcon name="tag" size={18} /> ~/tags
      </a>
      <a
        href="/about"
        class={`pixel-btn px-3 py-2 flex items-center gap-3 text-base ${
          navActive === 'about'
            ? 'bg-blue-100 dark:bg-green-900/40 text-blue-600 dark:text-green-400 border-l-2 border-blue-500 dark:border-green-500'
            : 'text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white'
        }`}
      >
        <LucideIcon name="user" size={18} /> ~/about
      </a>
      <a
        href="/archive"
        class={`pixel-btn px-3 py-2 flex items-center gap-3 text-base ${
          navActive === 'archive'
            ? 'bg-blue-100 dark:bg-green-900/40 text-blue-600 dark:text-green-400 border-l-2 border-blue-500 dark:border-green-500'
            : 'text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white'
        }`}
      >
        <LucideIcon name="file-text" size={18} /> ~/archive
      </a>
    </div>
  </div>

  {networkLinks.length > 0 && (
    <div class="pixel-panel p-4 flex flex-col gap-3">
      <h2 class="font-pixel text-sm text-gray-500 mb-1">NETWORK</h2>
      {networkLinks.map((link) => (
        <a
          href={link.href}
          class="text-gray-500 dark:text-gray-400 hover:text-blue-600 dark:hover:text-green-400 flex items-center gap-3 text-base transition-colors"
        >
          <LucideIcon name={link.icon} size={18} /> {link.label}
        </a>
      ))}
    </div>
  )}

  <div class="pixel-panel p-4 flex flex-col gap-3">
    <h2 class="font-pixel text-sm text-gray-500 mb-1">SEARCH</h2>
    <div class="flex items-center gap-2 border border-gray-300 dark:border-[#333] bg-white dark:bg-[#111] px-3 py-2">
      <span class="text-blue-600 dark:text-green-500 font-bold shrink-0">$ grep</span>
      <input
        data-sidebar-grep-input
        type="text"
        class="flex-1 bg-transparent outline-none text-gray-900 dark:text-white font-console min-w-0 text-base"
        placeholder="hello"
        autocomplete="off"
        spellcheck="false"
        aria-label="Grep search input"
      />
    </div>
  </div>

  <div class="mt-auto text-xs text-gray-500 dark:text-gray-600 text-center font-pixel">
    SYS.VER 1.0.4
    <br />© 2026
  </div>
</div>

<script is:inline>
  (() => {
    const initSidebarGrep = () => {
      document.querySelectorAll('[data-sidebar-grep-input]').forEach((element) => {
        if (!(element instanceof HTMLInputElement)) return;
        if (element.dataset.bound === 'true') return;
        element.dataset.bound = 'true';
        const params = new URLSearchParams(window.location.search);
        const q = params.get('q');
        if (q) element.value = q;
        element.addEventListener('keydown', (event) => {
          if (event.key !== 'Enter') return;
          const query = element.value.trim();
          const next = query ? `/search?q=${encodeURIComponent(query)}` : '/search';
          window.location.assign(next);
        });
      });
    };

    initSidebarGrep();
    if (document.documentElement.dataset.sidebarGrepLifecycleBound !== 'true') {
      document.documentElement.dataset.sidebarGrepLifecycleBound = 'true';
      document.addEventListener('astro:page-load', initSidebarGrep);
      document.addEventListener('astro:after-swap', initSidebarGrep);
    }
  })();
</script>
