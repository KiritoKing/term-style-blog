---
import TerminalPanelInteractive from '@/components/react/TerminalPanel';

interface Props {
  promptPath: string;
  route: string;
  postIndex: { id: string; category: string; tags: string[] }[];
}

const { promptPath, route, postIndex } = Astro.props;
---

<TerminalPanelInteractive
  client:load
  data-astro-reload
  promptPath={promptPath}
  route={route}
  postIndex={postIndex}
/>
