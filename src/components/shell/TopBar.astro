---
import LucideIcon from '@/components/icons/LucideIcon.astro';

interface Props {
  headerPath: string;
}

const { headerPath } = Astro.props;
---

<div class="bg-gray-200 dark:bg-[#111] border-b border-gray-300 dark:border-[#333] p-2 flex items-center justify-between select-none">
  <div class="min-w-0 flex-1 flex items-center gap-2 mr-2 text-gray-600 dark:text-gray-400 text-sm font-pixel">
    <LucideIcon name="command" size={14} />
    <span class="truncate" title={`chlorinec@blog:${headerPath}`}>chlorinec@blog:{headerPath}</span>
  </div>
  <div class="shrink-0 flex items-center gap-4">
    <div class="flex gap-2 mr-2">
      <button
        type="button"
        data-a11y-toggle
        class="p-1 rounded transition-colors cursor-pointer text-gray-500 hover:text-blue-600 dark:hover:text-green-400 hover:bg-gray-300 dark:hover:bg-[#222]"
        title="Enable Accessibility Mode"
        aria-label="Toggle Accessibility Mode"
        aria-pressed="false"
      >
        <LucideIcon name="accessibility" size={16} />
      </button>
      <button
        type="button"
        data-theme-toggle
        class="p-1 rounded text-gray-500 hover:text-blue-600 dark:hover:text-green-400 hover:bg-gray-300 dark:hover:bg-[#222] transition-colors cursor-pointer"
        title="Switch to Light Mode"
        aria-label="Toggle Theme"
      >
        <LucideIcon name="sun" size={16} />
        <span class="sr-only">Toggle Theme</span>
      </button>
    </div>
    <div class="flex gap-2">
      <div class="w-3 h-3 bg-[#ff5f56] rounded-full"></div>
      <div class="w-3 h-3 bg-[#ffbd2e] rounded-full"></div>
      <div class="w-3 h-3 bg-[#27c93f] rounded-full"></div>
    </div>
  </div>
</div>
