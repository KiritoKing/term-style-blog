---
import ContentFrame from '@/components/shell/ContentFrame.astro';
import Sidebar from '@/components/shell/Sidebar.astro';
import TerminalPanel from '@/components/shell/TerminalPanel.astro';
import TopBar from '@/components/shell/TopBar.astro';
import Layout from '@/layouts/Layout.astro';
import { getAllPosts } from '@/data/blog';

interface Props {
  route?: string;
  title?: string;
  description?: string;
  article?: boolean;
  publishedTime?: string;
  updatedTime?: string;
}

const { route: routeProp, title, description, article, publishedTime, updatedTime } = Astro.props;

const normalizedPathname = Astro.url.pathname.replace(/^\/|\/$/g, '');
const route = routeProp ?? (normalizedPathname === '' ? 'home' : normalizedPathname);

const navActiveBase = route === 'home' ? 'home' : route.split('/')[0];
const navActive =
  navActiveBase === 'post'
    ? 'posts'
    : navActiveBase === 'category'
      ? 'categories'
      : navActiveBase === 'tag'
        ? 'tags'
        : navActiveBase;

const promptPath = () => {
  if (route === 'home') return '~';
  return `~/${route}`;
};

const headerPath = route === 'home' ? '~' : `~/${route}`;
const promptPathValue = promptPath();

const posts = await getAllPosts();
const postIndex = posts.map((post) => ({
  id: post.slug ?? post.id,
  category: post.category,
  tags: post.tags,
}));
---

<Layout {title} {description} {article} {publishedTime} {updatedTime}>
  <div class="min-h-screen bg-gray-100 dark:bg-[#050505] text-gray-900 dark:text-[#e5e5e5] font-console p-2 md:p-6 flex items-center justify-center relative overflow-hidden" data-terminal-shell>
    <div class="scanlines" transition:name="scanlines"></div>

    <div class="w-full max-w-[90rem] h-[calc(100dvh-1rem)] md:h-[95vh] flex flex-col md:flex-row gap-2 md:gap-4 relative z-10 min-w-0">
      <details class="md:hidden pixel-panel" data-mobile-navigation>
        <summary class="cursor-pointer px-4 py-3 font-pixel text-xs text-blue-600 dark:text-green-400">MENU ~/</summary>
        <Sidebar navActive={navActive} />
      </details>
      <div transition:name="sidebar" class="crt-flicker hidden md:block">
        <Sidebar navActive={navActive} />
      </div>
      <div class="flex-1 min-w-0 pixel-panel flex flex-col overflow-hidden bg-white dark:bg-[#020202]">
        <div transition:name="topbar" class="crt-flicker">
          <TopBar headerPath={headerPath} />
        </div>
        <div class="flex-1 min-w-0 flex flex-col overflow-hidden" transition:name="content">
          <ContentFrame>
            <slot />
          </ContentFrame>
        </div>
        <details class="md:hidden border-t border-gray-300 dark:border-[#333]" data-mobile-terminal>
          <summary class="cursor-pointer px-4 py-2 font-pixel text-xs text-blue-600 dark:text-green-400">TERMINAL $</summary>
          <TerminalPanel promptPath={promptPathValue} route={route} postIndex={postIndex} />
        </details>
        <div transition:name="terminal" class="crt-flicker hidden md:block">
          <TerminalPanel promptPath={promptPathValue} route={route} postIndex={postIndex} />
        </div>
      </div>
      <div class="hidden xl:block w-64 shrink-0 crt-flicker" transition:name="right-sidebar">
        <slot name="right-sidebar" />
      </div>
    </div>
  </div>
</Layout>

<script>
  const makeWideMermaidDiagramsReadable = () => {
    document.querySelectorAll<HTMLElement>('.prose-terminal .mermaid').forEach((container) => {
      if (container.dataset.blogMermaidComplete !== 'true') return;
      const svg = container.querySelector<SVGSVGElement>(':scope > svg[viewBox]');
      if (!svg) return;

      if (container.dataset.mermaidScrollable === 'true') {
        svg.style.removeProperty('width');
        delete container.dataset.mermaidScrollable;
      }

      const naturalWidth = svg.viewBox.baseVal.width;
      if (!Number.isFinite(naturalWidth) || naturalWidth <= container.clientWidth + 1) return;

      svg.style.width = `${Math.ceil(naturalWidth)}px`;
      container.dataset.mermaidScrollable = 'true';
    });
  };

  const installMermaidReadability = () => {
    if (document.documentElement.dataset.mermaidReadabilityInstalled === 'true') return;

    document.documentElement.dataset.mermaidReadabilityInstalled = 'true';
    let scheduled = false;
    const scheduleRefresh = () => {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(() => {
        scheduled = false;
        makeWideMermaidDiagramsReadable();
      });
    };

    document.addEventListener('blog:mermaid-rendered', scheduleRefresh);
    window.addEventListener('resize', scheduleRefresh, { passive: true });
    document.addEventListener('astro:page-load', scheduleRefresh);
  };

  installMermaidReadability();
</script>
