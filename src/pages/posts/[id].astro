---
import ShellLayout from '@/layouts/ShellLayout.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { formatDate, normalizeBlogPost } from '@/data/blog';
import LucideIcon from '@/components/icons/LucideIcon.astro';
import Comments from '@/components/react/Comments';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const postsMeta = posts.map(normalizeBlogPost)
  return postsMeta.map((post) => ({
    params: { id: post.id },
  }));
}

const { id } = Astro.params;

if (!id) {
  throw new Error('Post id is required.');
}

const post = await getEntry('blog', id);

if (!post) {
  throw new Error(`Post not found: ${id}`);
}

const { Content, headings } = await render(post);
const postMeta = normalizeBlogPost(post);
const hasToc = headings.length > 0;
const minDepth = hasToc ? Math.min(...headings.map((heading) => heading.depth)) : 0;
const tocItems = hasToc
  ? headings.map((heading) => ({
      ...heading,
      level: heading.depth - minDepth,
    }))
  : [];
const siteOrigin = Astro.site?.toString() ?? new URL(Astro.url).origin;
const giscusConfig = {
  repo: import.meta.env.PUBLIC_GISCUS_REPO ?? '',
  repoId: import.meta.env.PUBLIC_GISCUS_REPO_ID ?? '',
  category: import.meta.env.PUBLIC_GISCUS_CATEGORY ?? '',
  categoryId: import.meta.env.PUBLIC_GISCUS_CATEGORY_ID ?? '',
  themeLight: new URL('/giscus-terminal-light.css', siteOrigin).toString(),
  themeDark: new URL('/giscus-terminal-dark.css', siteOrigin).toString(),
};
---

<ShellLayout>
  <div class="animate-in fade-in duration-300">
    <p class="text-blue-600 dark:text-green-400 mb-6">$ cat ~/posts/{post.id}.md</p>
    <div class="relative">
        <div class="border border-gray-300 dark:border-[#333] bg-gray-50 dark:bg-[#0a0a0a] p-6 md:p-8 text-gray-700 dark:text-gray-300 relative">
          <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-blue-500/50 dark:from-green-500/50 to-transparent"></div>
          <h1 class="text-3xl md:text-5xl font-pixel text-gray-900 dark:text-white mb-4 text-glow-white">
            {postMeta.title}
          </h1>
          <div class="flex flex-wrap gap-4 text-sm text-gray-500 mb-8 border-b border-gray-300 dark:border-[#333] pb-4">
            <span class="bg-white dark:bg-[#111] px-2 py-1 rounded border border-gray-200 dark:border-[#222]">
              DATE: {formatDate(postMeta.date)}
            </span>
            <a
              href={`/categories/${postMeta.category.toLowerCase()}`}
              class="bg-white dark:bg-[#111] px-2 py-1 rounded border border-gray-200 dark:border-[#222] cursor-pointer hover:border-blue-500 dark:hover:border-green-500 hover:text-blue-600 dark:hover:text-green-400 transition-colors"
            >
              CATEGORY: {postMeta.category}
            </a>
            <span class="bg-white dark:bg-[#111] px-2 py-1 rounded border border-gray-200 dark:border-[#222] flex gap-1">
              TAGS:
              {postMeta.tags.map((tag, idx) => (
                <span>
                  <a
                    href={`/tags/${tag.toLowerCase()}`}
                    class="cursor-pointer hover:text-blue-600 dark:hover:text-green-400 transition-colors"
                  >
                    {tag}
                  </a>
                  {idx < postMeta.tags.length - 1 ? ', ' : ''}
                </span>
              ))}
            </span>
          </div>

          {hasToc && (
            <div class="xl:hidden mb-8 pixel-panel p-4 font-console text-gray-700 dark:text-gray-300 bg-white dark:bg-[#111]" data-toc>
              <h2 class="font-pixel text-xs text-gray-500 dark:text-gray-400 mb-3 border-b border-gray-200 dark:border-[#222] pb-2">
                TABLE OF CONTENTS
              </h2>
              <nav>
                <ul class="flex flex-col gap-2 text-base">
                  {tocItems.map((heading) => (
                    <li style={`padding-left: ${heading.level * 12}px`}>
                      <a
                        href={`#${heading.slug}`}
                        class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-green-400 transition-colors"
                      >
                        {heading.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            </div>
          )}

          <div class="prose-terminal">
            <Content />
          </div>
        </div>
      </div>
  </div>

  {hasToc && (
    <aside
      slot="right-sidebar"
      class="h-full pixel-panel p-4 font-console text-gray-700 dark:text-gray-300 bg-white dark:bg-[#020202] overflow-y-auto custom-scrollbar"
      data-toc
    >
      <h2 class="font-pixel text-xs text-gray-500 dark:text-gray-400 mb-3 border-b border-gray-200 dark:border-[#222] pb-2">
        TABLE OF CONTENTS
      </h2>
      <nav>
        <ul class="flex flex-col gap-2 text-base">
          {tocItems.map((heading) => (
            <li style={`padding-left: ${heading.level * 12}px`}>
              <a
                href={`#${heading.slug}`}
                class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-green-400 transition-colors block py-0.5"
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>
  )}
  <script is:inline>
    const initTocScroll = () => {
      const tocs = document.querySelectorAll('[data-toc]');
      tocs.forEach((toc) => {
        if (!(toc instanceof HTMLElement)) return;
        if (toc.dataset.bound === 'true') return;
        toc.dataset.bound = 'true';

        toc.addEventListener('click', (event) => {
          const target = event.target;
          if (!(target instanceof HTMLElement)) return;
          const link = target.closest('a[href^="#"]');
          if (!(link instanceof HTMLAnchorElement)) return;

          const hash = link.getAttribute('href');
          if (!hash) return;
          const id = decodeURIComponent(hash.slice(1));
          if (!id) return;

          event.preventDefault();

          const heading = document.getElementById(id);
          if (!(heading instanceof HTMLElement)) return;

          const scroller = document.getElementById('content-scroll');
          if (!(scroller instanceof HTMLElement)) return;

          const scrollerRect = scroller.getBoundingClientRect();
          const headingRect = heading.getBoundingClientRect();
          const top = scroller.scrollTop + (headingRect.top - scrollerRect.top) - 16;
          scroller.scrollTo({ top, behavior: 'smooth' });

          history.replaceState(null, '', `#${encodeURIComponent(id)}`);
        });
      });
    };

    initTocScroll();
    document.addEventListener('astro:page-load', initTocScroll);
    document.addEventListener('astro:after-swap', initTocScroll);
  </script>
    <section class="mt-8 pixel-panel p-6 md:p-8 text-gray-700 dark:text-gray-300">
      <div class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 mb-4">
        <span class="font-pixel text-xs">COMMENTS</span>
        <span class="text-blue-600 dark:text-green-400"># giscus</span>
      </div>
      <div class="giscus-terminal">
        <Comments
          client:load
          repo={giscusConfig.repo}
          repoId={giscusConfig.repoId}
          category={giscusConfig.category}
          categoryId={giscusConfig.categoryId}
          mapping="pathname"
          strict="1"
          reactionsEnabled="1"
          emitMetadata="0"
          inputPosition="bottom"
          lang="zh-CN"
          themeLight={giscusConfig.themeLight}
          themeDark={giscusConfig.themeDark}
        />
      </div>
    </section>
    <a
      href="/posts"
      class="mt-6 text-blue-600 dark:text-green-500 hover:text-gray-900 dark:hover:text-white hover:bg-blue-100 dark:hover:bg-green-900/30 px-4 py-2 rounded flex items-center gap-2 transition-colors border border-transparent hover:border-blue-500/50 dark:hover:border-green-500/50 w-fit"
    >
      <LucideIcon name="chevron-right" size={18} /> cd ../
    </a>
  </div>
</ShellLayout>
