---
import ShellLayout from '@/layouts/ShellLayout.astro';
import { formatDate, getAllPosts, getPostPath } from '@/data/blog';
import LucideIcon from '@/components/icons/LucideIcon.astro';
import Pagination from '@/components/Pagination.astro';
import { paginate, PAGINATION } from '@/data/pagination';

const allPosts = await getAllPosts();
const pagination = paginate(allPosts, { page: 1, perPage: PAGINATION.postsPerPage });
const posts = pagination.items;
---

<ShellLayout>
  <div class="animate-in fade-in duration-300">
    <p class="text-blue-600 dark:text-green-400 mb-6">$ ls -la ~/posts</p>
    <div class="flex flex-col gap-2" data-listing-table>
      <div class="flex items-center gap-4 text-gray-500 border-b border-gray-300 dark:border-[#333] pb-2 mb-2 font-bold" data-listing-header>
        <span class="hidden md:inline-block md:w-24 whitespace-nowrap shrink-0" data-listing-permissions>PERMISSIONS</span>
        <span class="hidden md:inline-block md:w-16 whitespace-nowrap shrink-0" data-listing-owner>OWNER</span>
        <span class="w-24 whitespace-nowrap shrink-0" data-listing-date>DATE</span>
        <span>NAME</span>
      </div>
      {posts.map((post) => (
        <a
          href={getPostPath(post)}
          class="group cursor-pointer flex flex-col md:flex-row md:items-center gap-2 md:gap-4 py-2 hover:bg-gray-200 dark:hover:bg-[#111] px-2 -mx-2 rounded transition-colors"
          data-listing-row
        >
          <div class="flex items-center gap-4 text-gray-500 dark:text-gray-400 group-hover:text-gray-900 dark:group-hover:text-white transition-colors">
            <span class="text-blue-500 dark:text-blue-400 hidden md:inline-block md:w-24 whitespace-nowrap shrink-0" data-listing-permissions>-rw-r--r--</span>
            <span class="text-green-600 hidden md:inline-block md:w-16 whitespace-nowrap shrink-0" data-listing-owner>guest</span>
            <span class="w-24 whitespace-nowrap shrink-0" data-listing-date>{formatDate(post.date)}</span>
          </div>
          <div class="flex-1 flex flex-col md:flex-row md:items-center justify-between gap-2 min-w-0">
            <span class="text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-green-400 flex items-center gap-2 text-lg min-w-0">
              <LucideIcon name="file-text" size={18} class="inline text-gray-500 group-hover:text-blue-600 dark:group-hover:text-green-400 shrink-0" />
              <span class="truncate" title={`${post.title}.md`}>{post.title}.md</span>
            </span>
            <span class="text-sm text-gray-500 group-hover:text-gray-700 dark:group-hover:text-gray-300 md:text-right truncate shrink-0 md:max-w-[50%]" title={post.description}>
              # {post.description}
            </span>
          </div>
        </a>
      ))}
    </div>
    <Pagination basePath="/posts" page={pagination.page} totalPages={pagination.totalPages} />
  </div>
</ShellLayout>
